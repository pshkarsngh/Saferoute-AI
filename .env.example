# ===========================================================================
# SafeRoute AI — environment configuration template (03_ARCHITECTURE.md §8)
# Copy to .env and fill real values. NEVER commit real secrets.
# ===========================================================================

# --- App -------------------------------------------------------------
APP_ENV=development                 # development | testing | production
DEBUG=false
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------
# Local dev default (SQLite). Docker Compose / production: PostgreSQL 16.
DATABASE_URL=postgresql+psycopg://saferoute:saferoute@db:5432/saferoute

# --- Routing provider --------------------------------------------------
ROUTING_PROVIDER=osrm               # osrm | mock (mock is DEMO-only, clearly labeled)
ROUTING_BASE_URL=https://router.project-osrm.org
MAX_CANDIDATE_ROUTES=4

# --- Route segmentation ------------------------------------------------
SEGMENT_LENGTH_METERS=500

# --- Facility provider -------------------------------------------------
FACILITY_PROVIDER=overpass          # overpass | mock (mock is DEMO-only)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
FACILITY_SEARCH_RADIUS_KM=1.0
MAX_FACILITY_RESULTS=200

# --- Vision / ML (leave MODEL_PATH empty => YOLO unavailable, graceful) --
MODEL_PATH=ml/models/best.pt         # trained artifact (gitignored)
MODEL_NAME=SafeRoute-YOLO11
MODEL_VERSION=0.0.0
YOLO_CONFIDENCE_THRESHOLD=0.50
YOLO_IOU_THRESHOLD=0.45
IMAGE_MAX_SIZE_MB=10
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096

# --- Hazard aggregation ------------------------------------------------
CLUSTER_RADIUS_M=30.0

# --- Risk engine -------------------------------------------------------
HAZARD_WEIGHTS=pothole:3,road_crack:2,damaged_road:2,obstacle:1,debris:1
RISK_SCALE_MAX=100.0
RISK_NORM_GAIN=1.25
RISK_ENGINE_VERSION=1.0

# --- LLM (explanation layer only; blank key => deterministic fallback) --
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=25.0
LLM_PROMPT_VERSION=v1

# --- HTTP / security ---------------------------------------------------
REQUEST_TIMEOUT_S=15.0
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173